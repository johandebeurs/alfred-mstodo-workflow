{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug invoke build command",
            "type": "debugpy",
            "request": "launch",
            "module": "invoke",
            "args": [
                "-r",
                "build",
                "test"
            ]
        },
        {
            "name": "Debug current file",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Custom command",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/alfred_mstodo_workflow.py",
            "console": "integratedTerminal",
            "args": ["${input:command}", "${input:commitFlag}"]
        },
        {
            "name": "Simulate Welcome",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/alfred_mstodo_workflow.py",
            "console": "integratedTerminal",
            "args": [""]
        },
        {
            "name": "Simulate About",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/alfred_mstodo_workflow.py",
            "console": "integratedTerminal",
            "args": ["about"],
        },
        {
            "name": "Simulate Preferences",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/alfred_mstodo_workflow.py",
            "console": "integratedTerminal",
            "args": ["pref"],
        },
        {
            "name": "Simulate Logout",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/alfred_mstodo_workflow.py",
            "console": "integratedTerminal",
            "args": ["logout"],
        },
        {
            "name": "Simulate Login",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/alfred_mstodo_workflow.py",
            "console": "integratedTerminal",
            "args": ["", "--commit"],
        },
        {
            "name": "Simulate Sync",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/alfred_mstodo_workflow.py",
            "console": "integratedTerminal",
            "args": ["pref sync", "--commit"],
        }
    ],
    "inputs": [
        {
            "id": "command",
            "type": "promptString",
            "description": "Enter the command to run (e.g. 'about', 'pref', 'logout')"
        },
        {
            "id": "commitFlag",
            "type": "pickString",
            "description": "Add --commit flag?",
            "options": ["", "--commit"],
            "default": ""
        }
    ]
}